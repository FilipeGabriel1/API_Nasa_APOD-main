# Copie este arquivo para ".env" e preencha os valores.
# NUNCA commit o arquivo .env (ele fica ignorado pelo .gitignore).

# --- IA (OpenAI-compatible) ---
# OpenAI
AI_CHAT_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=COLE_SUA_CHAVE_AQUI
AI_CHAT_MODEL=gpt-4o-mini
AI_CHAT_AUTH_HEADER=Authorization
AI_CHAT_AUTH_SCHEME=Bearer
AI_CHAT_INCLUDE_MODEL=true

# Azure OpenAI (exemplo)
# AI_CHAT_URL=https://{resource}.openai.azure.com/openai/deployments/{deployment}/chat/completions?api-version=2024-06-01
# AI_API_KEY=COLE_SUA_CHAVE_AQUI
# AI_CHAT_AUTH_HEADER=api-key
# AI_CHAT_AUTH_SCHEME=
# AI_CHAT_INCLUDE_MODEL=false

# (Opcional) Regras/estilo de resposta e conhecimento específico
# AI_CHAT_SYSTEM_PROMPT=Responda sempre em português. Se não houver evidência, diga que não sabe.
# AI_CHAT_KNOWLEDGE=Coloque aqui um FAQ curto\nPergunta: ...\nResposta: ...

# RAG (base de conhecimento em arquivos)
# Coloque arquivos .txt em: src/main/resources/ai/knowledge/
# Ajustes finos (opcionais):
# AI_CHAT_KNOWLEDGE_STRICT=false
# AI_CHAT_KNOWLEDGE_TOPK=4
# AI_CHAT_KNOWLEDGE_MAXCHARS=3500
# AI_CHAT_KNOWLEDGE_CHUNK_MAXCHARS=900

# Porta do servidor (opcional; por padrão está 8081 no application.properties)
SERVER_PORT=8081
